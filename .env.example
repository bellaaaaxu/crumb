# Copy to .env, or run `node scripts/init-secrets.mjs`, which writes one for you.
# See docs/DEPLOYMENT.md.

# The address people type into their browser. Anything other than localhost must be https://.
PUBLIC_ORIGIN=http://localhost:3000

# Only for trying Crumb on this computer over plain http://localhost.
ALLOW_LOCAL_HTTP=true

# HTTPS with compose.https.yaml: the domain Caddy gets a certificate for.
# SITE_ADDRESS=crumb.example.com

# Which Docker volume holds the database. Change it to switch to a restored copy
# (docs/OPERATIONS.md); change it back to roll back.
# CRUMB_DATA_VOLUME=crumb_data
