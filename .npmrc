# No dependency needs an install script. better-sqlite3 ships ready-made
# binaries for Linux, macOS and Windows (x64 and arm64) and loads them
# directly, but `npm ci` still tries to compile it from source because of its
# binding.gyp — which fails on machines without a C++ toolchain. Skipping
# install scripts avoids that, and also means no package can run code at
# install time. `npm test`, `npm start` and `npm run …` are unaffected.
ignore-scripts=true
